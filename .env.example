VITE_SUPABASE_URL=TU_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# Telemetría — OPCIONAL.
# Si faltan, la app funciona igual y no se envía nada a ningún sitio.

# Sentry → sentry.io, proyecto React. El DSN está en Settings > Client Keys.
VITE_SENTRY_DSN=

# PostHog → posthog.com. La clave está en Settings > Project > Project API Key.
# Empieza por phc_. Es pública por diseño, como la anon key de Supabase.
VITE_POSTHOG_KEY=
# Cambia a https://eu.i.posthog.com si elegiste la región europea al registrarte.
VITE_POSTHOG_HOST=https://us.i.posthog.com
